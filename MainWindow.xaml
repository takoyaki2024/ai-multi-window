<Window x:Class="AiMultiWindow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Multi Window"
        Width="1500"
        Height="900"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#F3F4F6" BorderBrush="#D1D5DB" BorderThickness="0,0,0,1">
            <Grid Margin="10,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="分割" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button x:Name="Layout1Button" Content="1" Width="38" Height="32" Margin="0,0,5,0" Click="LayoutButton_Click" Tag="1" ToolTip="1画面 (Ctrl+1)"/>
                    <Button x:Name="Layout2Button" Content="2" Width="38" Height="32" Margin="0,0,5,0" Click="LayoutButton_Click" Tag="2" ToolTip="左右2分割 (Ctrl+2)"/>
                    <Button x:Name="Layout3Button" Content="3" Width="38" Height="32" Margin="0,0,5,0" Click="LayoutButton_Click" Tag="3" ToolTip="左大 + 右上下 (Ctrl+3)"/>
                    <Button x:Name="Layout4Button" Content="4" Width="38" Height="32" Click="LayoutButton_Click" Tag="4" ToolTip="4分割 (Ctrl+4)"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="AI Multi Window"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="16"
                           FontWeight="SemiBold"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="均等に戻す" Height="32" Padding="12,0" Margin="0,0,6,0" Click="ResetLayout_Click" ToolTip="分割比率を初期状態に戻します"/>
                    <Button Content="全画面" Height="32" Padding="12,0" Click="Fullscreen_Click" ToolTip="F11"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="10,5">
            <TextBlock x:Name="StatusText" Foreground="#6B7280" Text="準備完了"/>
        </Border>

        <Grid x:Name="LayoutHost" Background="#111827"/>
    </DockPanel>
</Window>
